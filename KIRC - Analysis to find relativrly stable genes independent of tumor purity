round(quantile(col_data_kr_tumor$CPE,probs = seq(0.0,1.0, by = 0.05)),2) 
# 0%    5%      10%  15%  20%  25%  30%  35%  40%  45%  50%
# 0.21  0.43   0.48 0.52 0.54 0.57 0.59 0.62 0.63 0.66 0.68

#55%  60%  65%  70%  75%  80%  85%  90%   100%
#0.69 0.71 0.72 0.73 0.75 0.77 0.80 0.83   0.9947

q80 <- quantile(col_data_kr_tumor$CPE,0.80)
q60 <- quantile(col_data_kr_tumor$CPE,0.60)
q40 <- quantile(col_data_kr_tumor$CPE,0.40)
q20 <- quantile(col_data_kr_tumor$CPE, 0.20)


col_data_kr_tumor <- col_data_kr_tumor %>%
  mutate(tumor_purity_group = case_when(
    CPE >= q80                  ~ "CPE_very_high",   
    CPE <  q80 & CPE >= q60     ~ "CPE_high",        
    CPE <  q60 & CPE >= q40     ~ "CPE_moderate",   
    CPE <  q40 & CPE >= q20     ~ "CPE_low",         
    CPE <  q20                  ~ "CPE_very_low"     
  ))

col_data_kr_tumor$CPE <- as.numeric(col_data_kr_tumor$CPE )

