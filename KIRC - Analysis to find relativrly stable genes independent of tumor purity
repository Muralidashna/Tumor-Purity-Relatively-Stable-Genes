#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#
#                           XXV      Heatmap (KIRC)
#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#

#------------------------------------------------------------------#
# Z-score — anchored to Normal samples only, not the pooled
# Normal+Tumor population.
#------------------------------------------------------------------#

normal_barcodes_kr <- col_data_kr$barcode[col_data_kr$tissue_type == "Normal"]

cpm_dge_expr_matrix_kr_heatmap_genes <- combat_log[c(SetFinal_up_clean, SetFinal_down_clean), col_data_kr$barcode]

mean_normal_kr <- apply(cpm_dge_expr_matrix_kr_heatmap_genes[, normal_barcodes_kr], 1, mean)
sd_normal_kr   <- apply(cpm_dge_expr_matrix_kr_heatmap_genes[, normal_barcodes_kr], 1, sd)

# Guard against zero-variance genes in the Normal group specifically.

stopifnot(sum(sd_normal_kr == 0) == 0)

mat_z_kr <- sweep(cpm_dge_expr_matrix_kr_heatmap_genes, 1, mean_normal_kr, "-")
mat_z_kr <- sweep(mat_z_kr, 1, sd_normal_kr, "/")

stopifnot(sum(is.na(mat_z_kr)) == 0)

quantile(abs(mat_z_kr), c(0.5, 0.9, 0.95, 0.99, 1))

# Check this quantile output before trusting the clip at 6 — KIRC's own
# distribution may differ from LUSC's/BRCA's; adjust if the 95-99th
# percentile suggests a different cutoff keeps more real gradation.

mat_z_kr[mat_z_kr >  6] <-  6
mat_z_kr[mat_z_kr < -6] <- -6

#------------------------------------------------------------------------------#
#                           Annotations for the heatmap
#------------------------------------------------------------------------------#

annotation_col_kr <- data.frame(
  row.names = col_data_kr$barcode,
  tissue_type = col_data_kr$tissue_type,
  Tumor_purity_group = col_data_kr$tumor_purity_group
)

SetFinal_up_df_kr <- as.data.frame(SetFinal_up_clean)
SetFinal_up_df_kr$Direction <- rep("Up", nrow(SetFinal_up_df_kr))
colnames(SetFinal_up_df_kr) <- c("Gene","Direction")

SetFinal_down_df_kr <- as.data.frame(SetFinal_down_clean)
SetFinal_down_df_kr$Direction <- rep("Down", nrow(SetFinal_down_df_kr))
colnames(SetFinal_down_df_kr) <- c("Gene","Direction")

SET_Final_df_kr <- rbind(SetFinal_up_df_kr, SetFinal_down_df_kr)

annotation_row_kr <- data.frame(
  row.names = SET_Final_df_kr$Gene,
  Direction = SET_Final_df_kr$Direction
)

library(pheatmap)

# Same custom red-white-blue ramp and symmetric breaks as LUSC/BRCA, for
# visual consistency across all three cohort figures.

my_colors <- colorRampPalette(c("blue", "white", "red"))(100)
my_breaks <- seq(-6, 6, length.out = 101)

pheatmap(mat_z_kr,
         annotation_col = annotation_col_kr,
         annotation_row = annotation_row_kr,
         show_rownames = FALSE,
         show_colnames = FALSE,
         color = my_colors,
         breaks = my_breaks,
         cluster_rows = FALSE,
         cluster_cols = FALSE
         )

