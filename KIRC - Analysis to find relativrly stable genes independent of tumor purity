#------------------------------------------------------------------------------#
#                        XXVI  Violin Plot — CPE by Purity Group (KIRC)
#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#

library(ggplot2)

# Use only the tumor samples (Normal has no CPE, by construction) and set
# a sensible factor order so the groups appear from lowest to highest
# purity left-to-right, rather than alphabetical default order.

col_data_kr_tumor$tumor_purity_group <- factor(
  col_data_kr_tumor$tumor_purity_group,
  levels = c("CPE_very_low", "CPE_low", "CPE_moderate", "CPE_high", "CPE_very_high")
)

# Reconvert CPE to numeric if it's still character from the earlier
# as.character() conversions done before the rbind() steps.

col_data_kr_tumor$CPE <- as.numeric(as.character(col_data_kr_tumor$CPE))

violin_plot <-  ggplot(col_data_kr_tumor, aes(x = tumor_purity_group, y = CPE, fill = tumor_purity_group)) +
  geom_violin(trim = FALSE, alpha = 0.7) +
  geom_boxplot(width = 0.1, fill = "white", outlier.shape = NA) +
  geom_jitter(width = 0.08, size = 0.6, alpha = 0.3, color = "black") +
  scale_fill_manual(values = c(
    "CPE_very_low"  = "#2166AC",
    "CPE_low"       = "#67A9CF",
    "CPE_moderate"  = "#F7F7F7",
    "CPE_high"      = "#EF8A62",
    "CPE_very_high" = "#B2182B"
  )) +
  labs(
    title = "CPE Distribution Across Purity Groups (KIRC)",
    x = "Tumor Purity Group",
    y = "CPE (Tumor Purity)"
  ) +
  theme_minimal(base_size = 13) +
  theme(
    legend.position = "none",
    axis.text.x = element_text(angle = 30, hjust = 1)
  )

print(violin_plot)


