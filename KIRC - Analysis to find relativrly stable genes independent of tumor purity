# Load everything
library(TCGAbiolinks)
library(SummarizedExperiment)
library(edgeR)
library(org.Hs.eg.db)
library(tidyverse)
library(ggplot2)
library(limma)
library(dplyr)
library(UpSetR)
library(pheatmap)
library(sva)
