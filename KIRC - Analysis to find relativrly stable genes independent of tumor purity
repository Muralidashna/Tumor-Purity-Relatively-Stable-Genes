#                        II. Setting up the expression matrix

#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#

# Load the expr_matrix to the environment — the mRNA expression matrix of
# the KIRC cohort, restricted to protein-coding genes with gene_id rownames
# swapped for gene_name, same two-step process as LUSC.

expr_matrix_kr <- as.data.frame(assay(se_kr))

# We cannot directly replace the gene ids of the expression matrix with gene
# names. The expression matrix has genes represented by gene ids. The gene
# data we load next has the gene_ids and their corresponding gene names —
# we use it to subset expr_matrix to only protein-coding genes, then replace
# gene_id with gene_name once the ordering is confirmed to match.

gene_data <- as.data.frame(rowRanges(se_kr))

gene_data <- gene_data %>%
  filter(gene_type == "protein_coding") %>%
  distinct(gene_name, .keep_all = TRUE)

# Subsetting the expr_matrix for the protein-coding genes.

expr_matrix_kr <- expr_matrix_kr[gene_data$gene_id, ]

# Confirm gene_id ordering in gene_data matches the rownames of expr_matrix
# before renaming — same "if A=B and B=C then A=C" logic as LUSC.

all(gene_data$gene_id == rownames(expr_matrix_kr))
#[1] TRUE

rownames(expr_matrix_kr) <- gene_data$gene_name

