linear_combat <- 2^(combat_log)


#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#
#                 XXIII  Lets calculate the median change between Tumor and 
#               Normal Samples of the SET_final_up genes (KIRC)
#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#

linear_combat_up <- linear_combat[SetFinal_up_clean,]

#For Tumor 
linear_combat_tumor_up <- linear_combat_up[,col_data_kr_tumor$barcode]
median_up_genes_tumor <- apply(linear_combat_tumor_up,1,median)
q25_up_genes_tumor    <- apply(linear_combat_tumor_up,1,quantile,probs = 0.25)
mean_up_genes_tumor   <- apply(linear_combat_tumor_up,1,mean) 
sd_up_genes_tumor     <- apply(linear_combat_tumor_up,1,sd)

#For Normal
linear_combat_normal_up <- linear_combat_up[,col_data_kr_normal$barcode]
median_up_genes_normal <- apply(linear_combat_normal_up,1,median)
mean_up_genes_normal   <- apply(linear_combat_normal_up,1,mean) 
sd_up_genes_normal     <- apply(linear_combat_normal_up,1,sd)

# Data_frame
median_up_tumor_vs_normal_df <- data.frame(
  gene      = names(median_up_genes_tumor),
  sd_tumor_up = sd_up_genes_tumor,
  mean_tumor_up = mean_up_genes_tumor,
  median_tumor_up = median_up_genes_tumor,
  q25_tumor_up    = q25_up_genes_tumor,
  sd_normal_up   = sd_up_genes_normal,
  mean_normal_up = mean_up_genes_normal,
  median_normal_up = median_up_genes_normal
)

median_up_tumor_vs_normal_df <- median_up_tumor_vs_normal_df %>%
  mutate(Tumor_median_div_Normal_median = median_tumor_up/median_normal_up ,
         Tumor_q25_div_Normal_median = q25_tumor_up/median_normal_up,
         cv_tumor = sd_tumor_up/mean_tumor_up,
         cv_normal= sd_normal_up/mean_normal_up)

median_up_tumor_vs_normal_df <- median_up_tumor_vs_normal_df %>%
  mutate(
    tier = case_when(
      Tumor_median_div_Normal_median >= 2 & Tumor_q25_div_Normal_median >= 2   ~ "Tier 1",
      Tumor_median_div_Normal_median >= 2 & Tumor_q25_div_Normal_median >= 1.5   ~ "Tier 2",
      Tumor_median_div_Normal_median >= 2 & Tumor_q25_div_Normal_median > 1    ~ "Tier 3",
      Tumor_median_div_Normal_median >= 1.5 & Tumor_q25_div_Normal_median >= 1.5 ~ "Tier 4",
      Tumor_median_div_Normal_median >= 1.5 & Tumor_q25_div_Normal_median >= 1 ~ "Tier 5",
      Tumor_median_div_Normal_median >= 1                                     ~ "Tier 6",
      TRUE ~ "Below threshold"
    )
  )

median_up_tumor_vs_normal_df %>% count(tier)

