design <- model.matrix(~ batch_for_combat + tumor_purity_group,
                       data = col_data_lu_CPE_very_low_vs_normal)
v <- voom(dge, design, plot = FALSE)
fit <- lmFit(v, design)
fit <- eBayes(fit)
colnames(fit$coefficients)

