#------------------------------------------------------------------#
# Z-score — anchored to Normal samples only, not the pooled
# Normal+Tumor population.
#------------------------------------------------------------------#

normal_barcodes_lu <- col_data_lu$barcode[col_data_lu$tissue_type == "Normal"]

cpm_dge_expr_matrix_lu_heatmap_genes <- combat_log[c(SetFinal_up_clean, SetFinal_down_clean), col_data_lu$barcode]

mean_normal_lu <- apply(cpm_dge_expr_matrix_lu_heatmap_genes[, normal_barcodes_lu], 1, mean)
sd_normal_lu   <- apply(cpm_dge_expr_matrix_lu_heatmap_genes[, normal_barcodes_lu], 1, sd)

# Guard against zero-variance genes in the Normal group specifically —
# scale()'s pooled version would rarely hit this, but Normal alone is a
# smaller, more homogeneous group where sd = 0 is more plausible for a
# handful of genes. These would produce Inf/NaN below if unhandled.

stopifnot(sum(sd_normal_lu == 0) == 0)

mat_z_lu <- sweep(cpm_dge_expr_matrix_lu_heatmap_genes, 1, mean_normal_lu, "-")
mat_z_lu <- sweep(mat_z_lu, 1, sd_normal_lu, "/")

stopifnot(sum(is.na(mat_z_lu)) == 0)

quantile(abs(mat_z_lu), c(0.5, 0.9, 0.95, 0.99, 1))

# Check the quantile output above before picking the clip value — clip at
# whatever keeps ~95% of the matrix showing real gradation while trimming
# only the rarer extreme tail (6 was the right call for LUSC's own
# distribution when this was last run — reconfirm rather than assume).

mat_z_lu[mat_z_lu >  6] <-  6
mat_z_lu[mat_z_lu < -6] <- -6

