dge <- DGEList(counts = expr_matrix_lu[, col_data_lu_CPE_very_low_vs_normal$barcode])
keep <- filterByExpr(dge, group = col_data_lu_CPE_very_low_vs_normal$tumor_purity_group, min.count = 10)
dge <- dge[keep, , keep.lib.sizes = FALSE]
dge <- calcNormFactors(dge, method = "TMM")

