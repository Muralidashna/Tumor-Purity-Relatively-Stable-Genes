#                        II. Setting up the expression matrix   

#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#

# Now in this division of the code we will be loading the expression matrix 
# that is the mRNA expression matrix of the LUSC to the global environment
# remove the genes which are non protein coding and also change the names of the 
# rownames of the expression matrix from gene id's to the gene names.


# Loading the expr_matrix to the environment. 

expr_matrix_lu <- as.data.frame(assay(se_lu))

gene_data <- as.data.frame(rowRanges(se_lu))

# Remove the genes from the gene data which are not protein coding 

gene_data <- gene_data %>%
  filter(gene_type == "protein_coding") %>%
  distinct(gene_name , .keep_all = TRUE)


# subsetting the expr_matrix for the protein encoding genes 

expr_matrix_lu <- expr_matrix_lu[gene_data$gene_id,]

# Replace the gene ids with gene name 

all(gene_data$gene_id == rownames(expr_matrix_lu))

#[1] TRUE

# the logic behind using "all" function is that if every gene id is matched 
# with the rownames of the expression matrix in the same order and every gene 
# name is matched  with gene id in the gene data in the same order 
# Now since gene id are matched in gene data we can simply replace the gene_id 
# in expr_matrix with gene_name. 

# The logic being if A = B and if B = C , this means that A = C 

rownames(expr_matrix_lu) <- gene_data$gene_name

# As you can see down below 

rownames(expr_matrix_lu)[1:5]
