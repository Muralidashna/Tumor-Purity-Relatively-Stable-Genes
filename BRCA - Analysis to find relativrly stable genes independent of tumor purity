# p < 0.05 

col_data_br_CPE_very_high_vs_normal <- col_data_br_CPE_very_high_vs_normal %>%
  add_count(batch) %>%
  mutate(batch_for_combat = case_when(
    n >= 2 ~ batch,
    n <  2 ~ "other"
  ))

table(col_data_br_CPE_very_high_vs_normal$batch_for_combat)


tapply(col_data_br_CPE_very_high_vs_normal$age_at_index,
