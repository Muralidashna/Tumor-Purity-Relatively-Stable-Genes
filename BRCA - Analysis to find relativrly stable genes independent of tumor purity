#------------------------------------------------------------------------------#

annotation_col_br <- data.frame(
  row.names = col_data_br$barcode,
  tissue_type = col_data_br$tissue_type
)

SetFinal_up_df_br <- as.data.frame(SetFinal_up_clean)
SetFinal_up_df_br$Direction <- rep("Up", nrow(SetFinal_up_df_br))
colnames(SetFinal_up_df_br) <- c("Gene","Direction")

SetFinal_down_df_br <- as.data.frame(SetFinal_down_clean)
SetFinal_down_df_br$Direction <- rep("Down", nrow(SetFinal_down_df_br))
colnames(SetFinal_down_df_br) <- c("Gene","Direction")

SET_Final_df_br <- rbind(SetFinal_up_df_br, SetFinal_down_df_br)

annotation_row_br <- data.frame(
  row.names = SET_Final_df_br$Gene,
  Direction = SET_Final_df_br$Direction
)

library(pheatmap)

# Same custom red-white-blue ramp and symmetric breaks as LUSC, for
# visual consistency across all three cohort figures.

my_colors <- colorRampPalette(c("blue", "white", "red"))(100)
my_breaks <- seq(-6, 6, length.out = 101)

pheatmap(mat_z_br,
         annotation_col = annotation_col_br,
         annotation_row = annotation_row_br,
         show_rownames = FALSE,
         show_colnames = FALSE,
         color = my_colors,
         breaks = my_breaks,
         cluster_rows = FALSE,
         cluster_cols = FALSE)





