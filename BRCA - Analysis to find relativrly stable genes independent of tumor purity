#                       XXIV          Heatmap (BRCA)
#------------------------------------------------------------------------------#
#------------------------------------------------------------------------------#

#------------------------------------------------------------------#
# Z-score — anchored to Normal samples only, not the pooled
# Normal+Tumor population.
#------------------------------------------------------------------#

normal_barcodes_br <- col_data_br$barcode[col_data_br$tissue_type == "Normal"]

cpm_dge_expr_matrix_br_heatmap_genes <- combat_log[c(SetFinal_up_clean, SetFinal_down_clean), col_data_br$barcode]

mean_normal_br <- apply(cpm_dge_expr_matrix_br_heatmap_genes[, normal_barcodes_br], 1, mean)
sd_normal_br   <- apply(cpm_dge_expr_matrix_br_heatmap_genes[, normal_barcodes_br], 1, sd)

# Guard against zero-variance genes in the Normal group specifically.

stopifnot(sum(sd_normal_br == 0) == 0)

mat_z_br <- sweep(cpm_dge_expr_matrix_br_heatmap_genes, 1, mean_normal_br, "-")
mat_z_br <- sweep(mat_z_br, 1, sd_normal_br, "/")

stopifnot(sum(is.na(mat_z_br)) == 0)

quantile(abs(mat_z_br), c(0.5, 0.9, 0.95, 0.99, 1))

#50%       90%       95%       99%      100% 
#2.035595  4.117983  4.916845  6.818364 14.942388 

mat_z_br[mat_z_br >  6] <-  6
mat_z_br[mat_z_br < -6] <- -6

#------------------------------------------------------------------------------#
