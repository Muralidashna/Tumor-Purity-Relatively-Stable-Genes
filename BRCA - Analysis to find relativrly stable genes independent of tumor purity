# BRCA's CPE range (0.13-1.00) is the widest of the three cohorts,
# consistent with breast tumors' well-documented heterogeneity in
# stromal/immune infiltrate.

round(quantile(col_data_br_tumor$CPE, probs = seq(0.0,1, by = 0.05)),2) 

#0%   5%  10%  15%  20%  25%  30%  35%  40%  45%  50% 
#0.13 0.48 0.54 0.60 0.63 0.66 0.68 0.70 0.71 0.73 0.75 

