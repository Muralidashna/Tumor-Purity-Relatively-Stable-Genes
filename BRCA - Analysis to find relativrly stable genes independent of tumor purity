#Welch Two Sample t-test

#data:  col_data_br_CPE_very_high_vs_normal$age_at_index by col_data_br_CPE_very_high_vs_normal$tumor_purity_group
#t = 1.0902, df = 162.81, p-value = 0.2772
#alternative hypothesis: true difference in means between group CPE_very_high and group Normal is not equal to 0
#95 percent confidence interval:
#  -1.789284  6.200553
#sample estimates:
#  mean in group CPE_very_high        mean in group Normal 
#58.45865                    56.25301




#  Decision summary (CPE_very_high vs Normal, BRCA):
#  Batch → p < 0.05  → INCLUDE (ComBat) REGARDLESS OF PVALUE 
#  Age   → INCLUDE median difference is 5 years 


# ==============================================================================
# Comparison 1: CPE_very_high vs Normal (Set A1)
# Covariates: batch + age
# ==============================================================================

dge <- DGEList(counts = expr_matrix_br[, col_data_br_CPE_very_high_vs_normal$barcode])
keep <- filterByExpr(dge, group = col_data_br_CPE_very_high_vs_normal$tumor_purity_group, min.count = 10)
dge <- dge[keep, , keep.lib.sizes = FALSE]
dge <- calcNormFactors(dge, method = "TMM")

col_data_br_CPE_very_high_vs_normal$tumor_purity_group <- factor(
  col_data_br_CPE_very_high_vs_normal$tumor_purity_group, levels = c("Normal", "CPE_very_high"))
col_data_br_CPE_very_high_vs_normal$batch_for_combat <- factor(col_data_br_CPE_very_high_vs_normal$batch_for_combat)

design <- model.matrix(~ batch_for_combat + age_at_index + tumor_purity_group,
                       data = col_data_br_CPE_very_high_vs_normal)
v <- voom(dge, design, plot = FALSE)
fit <- lmFit(v, design)
fit <- eBayes(fit)
colnames(fit$coefficients)

results_limma_CPE_very_high_vs_normal <- topTable(fit, coef = "tumor_purity_groupCPE_very_high",
                                                  number = Inf, sort.by = "P")
results_limma_CPE_very_high_vs_normal$gene <- rownames(results_limma_CPE_very_high_vs_normal)

results_limma_CPE_very_high_vs_normal_sig_up <- results_limma_CPE_very_high_vs_normal %>%
  filter(adj.P.Val < 0.05 & logFC >= 1) %>% arrange(desc(logFC))
results_limma_CPE_very_high_vs_normal_sig_down <- results_limma_CPE_very_high_vs_normal %>%
  filter(adj.P.Val < 0.05 & logFC <= -1) %>% arrange(desc(logFC))

nrow(results_limma_CPE_very_high_vs_normal_sig_up)
# 1600
nrow(results_limma_CPE_very_high_vs_normal_sig_down)
# 3352
rm(dge, keep, design, v, fit)


