#0.75 0.77 0.78 0.79 0.81 0.83 0.85 0.86 0.89 0.91 1.00

q80 <- quantile(col_data_br_tumor$CPE,0.80)
q60 <- quantile(col_data_br_tumor$CPE,0.60)
q40 <- quantile(col_data_br_tumor$CPE,0.40)
q20 <- quantile(col_data_br_tumor$CPE,0.20)


col_data_br_tumor <- col_data_br_tumor %>%
  mutate(tumor_purity_group = case_when(
    CPE >= q80                  ~ "CPE_very_high",   
    CPE <  q80 & CPE >= q60    ~ "CPE_high",         
    CPE <  q60 & CPE >= q40    ~ "CPE_moderate",    
    CPE <  q40 & CPE >= q20    ~ "CPE_low",         
    CPE <  q20                 ~ "CPE_very_low"     
  ))

